{
  "schema": "C011-public-capture/1",
  "name": "final-loop",
  "kind": "portable projection, private originals unchanged",
  "privateOriginalRecordSha256": "11540dfafd6117c15bf94f667dcd2af87bccb9997166e91f3283daf50ad96104",
  "purpose": "Final 20x4 load repetitions under four positively spawned burners, with per-child records and native PID/creation identities recorded before load; originals retained, all owned burners must exit",
  "commandProjection": [
    "node.exe",
    "-e",
    "'use strict';\r\nconst fs = require('node:fs'), path = require('node:path'), cp = require('node:child_process');\r\nconst assert = require('node:assert/strict');\r\nconst root = process.argv[1], directory = process.env.C011_LOOP_OWNERSHIP_DIR;\r\nassert.ok(directory && path.isAbsolute(directory));\r\nconst relative = path.relative(path.join(root, 'private'), directory);\r\nassert.ok(relative && relative !== '..' && !relative.startsWith('..' + path.sep) && !path.isAbsolute(relative));\r\nfs.mkdirSync(directory, { recursive: false });\r\nprocess.chdir(root);\r\nconst original = cp.spawn;\r\nlet number = 0;\r\ncp.spawn = function (...args) {\r\n  const child = original.apply(this, args);\r\n  const id = String(++number).padStart(3, '0');\r\n  const record = {\r\n    owner: 'C011 current invocation positive ChildProcess handle', pid: child.pid, parentPid: process.pid,\r\n    command: args[0], args: args[1], createdByThisInvocation: true, startedAtUtc: new Date().toISOString()\r\n  };\r\n  let version = 0;\r\n  const save = () => fs.writeFileSync(path.join(directory, id + '.' + (++version) + '.json'), JSON.stringify(record, null, 2) + '\\n', { flag: 'wx' });\r\n  save();\r\n  child.once('close', (code, signal) => {\r\n    record.closed = true; record.code = code; record.signal = signal; save();\r\n  });\r\n  if (args[1]?.[0] === '-e' && args[1]?.[1] === 'for (;;) {}') {\r\n    record.burner = true;\r\n    try {\r\n      assert.ok(Number.isInteger(child.pid) && child.pid > 0);\r\n      const shell = path.join(process.env.SystemRoot, 'System32', 'WindowsPowerShell', 'v1.0', 'powershell.exe');\r\n      const script = `$ErrorActionPreference='Stop';$p=Get-Process -Id ${child.pid};@{pid=$p.Id;createdAt=$p.StartTime.ToUniversalTime().ToFileTimeUtc().ToString()}|ConvertTo-Json -Compress`;\r\n      const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => key.toLowerCase() !== 'psmodulepath'));\r\n      const observed = cp.spawnSync(shell, ['-NoLogo','-NoProfile','-NonInteractive','-EncodedCommand',Buffer.from(script,'utf16le').toString('base64')],\r\n        { env, windowsHide: true, timeout: 120000, maxBuffer: 1024 * 1024 });\r\n      assert.equal(observed.error, undefined);\r\n      assert.equal(observed.status, 0, String(observed.stderr));\r\n      const identity = JSON.parse(observed.stdout.toString('utf8'));\r\n      assert.equal(identity.pid, child.pid);\r\n      assert.match(identity.createdAt, /^\\d+$/);\r\n      record.nativeIdentity = identity;\r\n      save();\r\n    } catch (error) {\r\n      record.identityRefused = true; record.error = String(error.message); save();\r\n      child.kill();\r\n      throw error;\r\n    }\r\n  }\r\n  return child;\r\n};\r\nrequire(path.join(root, 'capability', 'C011', 'tests', 'loop.cjs'));\r\n",
    "<PRIVATE-C011>"
  ],
