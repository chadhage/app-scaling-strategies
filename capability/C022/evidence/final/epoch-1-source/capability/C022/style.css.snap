body { font: 16px/1.5 system-ui, sans-serif; margin: 0; color: #1b1b1b; background: #fff; }
main { max-width: 64rem; margin: 0 auto; padding: 1rem 1.25rem 3rem; }
input, button { font: inherit; padding: 0.35rem 0.6rem; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible { outline: 3px solid #0b5fff; outline-offset: 2px; }
table { border-collapse: collapse; width: 100%; margin: 0.75rem 0; }
caption { text-align: left; font-weight: 600; padding-bottom: 0.25rem; }
th, td { border: 1px solid #767676; padding: 0.3rem 0.5rem; text-align: left; vertical-align: top; }
td.ok { background: #e6f4ea; }
td.bad { background: #fdecea; }
#status { font-weight: 600; }
