'use strict';

// Test tooling, not production code: writes evidence/final/seal.json LAST (wx); the original seal stays byte-exact. SHA-256 (raw and
// LF-normalized) of the README, the feature, imports.json, every production file, every file under tests\ and every evidence file that no
// recorder manifest pins by itself (sealedEvidence: the manifests, the mutation, loop and fresh figures, the retained snapshots, the stub).
// evidence.test.cjs recomputes it.
//   node capability\C022\tests\seal.cjs
const fs = require('node:fs');
const path = require('node:path');
const { PRODUCTION, lf, sealedEvidence, sha } = require('./evidence-verify.cjs');

const root = path.resolve(__dirname, '..');
const names = [...PRODUCTION, 'README.md', 'C022.feature', 'C022-final.feature', 'imports.json', 'imports.final.json', ...fs.readdirSync(__dirname).filter((name) => /\.c?js$/.test(name)).map((name) => `tests/${name}`), ...sealedEvidence(root)].sort();
const files = {};
const lfs = {};
for (const name of names) {
  const bytes = fs.readFileSync(path.join(root, name));
  files[name] = sha(bytes);
  lfs[name] = sha(lf(bytes));
}
fs.writeFileSync(path.join(root, 'evidence', 'final', 'seal.json'), `${JSON.stringify({ schemaVersion: 1, previousSeal: { path: 'evidence/seal.json', sha256: sha(fs.readFileSync(path.join(root, 'evidence', 'seal.json'))), lf: sha(lf(fs.readFileSync(path.join(root, 'evidence', 'seal.json')))) }, note: 'append-only final seal; old seal and captures remain byte-exact. A consistent rewrite of this seal plus inputs needs an independent Git/publication anchor. verify-3 is produced after the seal and is outside it.', files, lf: lfs }, null, 1)}\n`, { flag: 'wx' });
console.log(`sealed ${names.length} files`);
