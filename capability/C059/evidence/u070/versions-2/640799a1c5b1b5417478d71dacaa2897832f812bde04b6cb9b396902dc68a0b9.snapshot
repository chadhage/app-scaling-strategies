:root { color-scheme: light; }
* { box-sizing: border-box; }
body { margin: 0 auto; max-width: 60rem; padding: 1rem; font-family: system-ui, sans-serif; font-size: 1rem; line-height: 1.5; color: #111; background: #fff; overflow-wrap: anywhere; }
h1 { font-size: 1.6rem; }
h2 { font-size: 1.3rem; margin-top: 1.5rem; }
h3 { font-size: 1.1rem; }
section, nav, header, footer { margin-block: 1rem; }
a { color: #0b4fa8; }
.skip-link { position: absolute; left: -100vw; padding: 0.5rem 1rem; background: #fff; border: 2px solid #111; }
.skip-link:focus-visible { left: 0.5rem; top: 0.5rem; z-index: 2; }
:focus-visible { outline: 3px solid #b3002d; outline-offset: 3px; }
[role="radiogroup"] { display: flex; flex-wrap: wrap; gap: 0.5rem; }
[role="radio"] { display: block; padding: 0.5rem 0.75rem; border: 2px solid #444; border-radius: 0.5rem; cursor: pointer; }
[role="radio"][aria-checked="true"] { background: #e6efff; border-style: double; border-width: 0.3rem; font-weight: 700; }
.row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
button { font: inherit; padding: 0.4rem 0.9rem; border: 2px solid #111; border-radius: 0.4rem; background: #f4f4f4; cursor: pointer; transition: background 0.15s; }
button:hover { background: #e2e2e2; }
[aria-disabled="true"] { border-style: dashed; color: #555; cursor: not-allowed; }
[aria-busy="true"] { cursor: progress; border-left: 0.4rem dotted #444; padding-left: 0.5rem; }
.field { margin-block: 0.75rem; }
label { display: block; font-weight: 700; }
input, select { font: inherit; padding: 0.3rem 0.5rem; min-width: 12rem; max-width: 100%; }
input[aria-invalid="true"], select[aria-invalid="true"] { border: 3px solid #b3002d; }
.help { margin: 0.2rem 0; color: #333; }
.error { margin: 0.2rem 0; font-weight: 700; color: #8a0020; }
.error::before { content: "Error: "; }
#error-summary { border: 3px solid #b3002d; padding: 0.5rem 1rem; margin-bottom: 1rem; }
dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; }
dt { font-weight: 700; }
dd { margin: 0; }
#status { margin-top: 1rem; padding: 0.75rem; border: 2px solid #111; min-height: 3rem; }
#result[data-outcome="succeeded"] { border-left: 0.5rem solid #0a6b2d; padding-left: 0.5rem; }
#result[data-outcome="rejected"], #result[data-outcome="unsupported"], #result[data-outcome="validation"] { border-left: 0.5rem solid #b3002d; padding-left: 0.5rem; }
#result[data-outcome="unknown"], #result[data-outcome="cancelled"], #result[data-outcome="interrupted"] { border-left: 0.5rem dashed #7a5200; padding-left: 0.5rem; }
iframe { width: 100%; min-height: 16rem; border: 2px solid #111; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }
