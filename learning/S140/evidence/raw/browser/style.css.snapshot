:root { color-scheme: light dark; font-family: system-ui, sans-serif; line-height: 1.5; }
body { margin: 0; background: #f4f6fa; color: #152336; }
main { max-width: 72rem; margin: auto; padding: 1.5rem; }
.banner { padding: 1rem; background: #ffe3a2; border: 3px solid #714900; color: #302000; font-weight: 800; }
.boundary, section { padding: 1rem; background: #fff; border: 1px solid #7d8999; border-radius: .3rem; }
section { margin-block: 1.25rem; }
form { display: grid; gap: .8rem; max-width: 40rem; }
label { display: block; font-weight: 700; }
input, select, button { font: inherit; padding: .6rem; }
input, select { width: min(100%, 35rem); box-sizing: border-box; background: #fff; color: #152336; border: 2px solid #66748a; }
button { color: #fff; background: #174476; border: 2px solid #174476; border-radius: .2rem; cursor: pointer; }
button:disabled { background: #e2e7ef; color: #4e5b6e; border-color: #a2acba; cursor: not-allowed; }
button:hover:not(:disabled) { background: #0a305d; }
:focus-visible { outline: 4px solid #c05a00; outline-offset: 3px; }
.actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-block: 1rem; }
#error { color: #a01c16; font-weight: 700; min-height: 1.5em; }
[aria-invalid="true"] { border-color: #a01c16; }
.verdict { font-size: 1.15rem; font-weight: 800; border-left: 5px solid #586a82; padding-left: .8rem; }
.positive, .pass { color: #12603b; }
.negative, .fail { color: #a01c16; }
.unknown { color: #6e4a00; }
li { margin-block: .4rem; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #edf1f7; padding: 1rem; border: 1px solid #8995a6; }
.table-scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: .9rem; }
caption { text-align: left; margin-bottom: .5rem; }
th, td { text-align: left; vertical-align: top; border: 1px solid #8995a6; padding: .5rem; }
th { background: #e4eaf2; }
footer { padding-block: 1rem; }
.skip { position: absolute; left: -10000px; }
.skip:focus { position: static; display: block; padding: .5rem; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
@media (max-width: 40rem) { main { padding: .75rem; } .actions button { width: 100%; } }
@media (prefers-color-scheme: dark) {
  body { background: #101b29; color: #eef3fa; }
  section, .boundary { background: #18283d; }
  input, select { background: #101b29; color: #eef3fa; }
  pre, th { background: #23374f; }
  .positive, .pass { color: #86e4b2; }
  .negative, .fail, #error { color: #ffac9d; }
  .unknown { color: #ffd780; }
}
