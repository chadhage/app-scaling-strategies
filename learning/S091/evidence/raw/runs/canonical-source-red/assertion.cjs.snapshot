const fs = require('node:fs'); const assert = require('node:assert/strict'); const crypto = require('node:crypto'); const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex'); const bdd = JSON.parse(fs.readFileSync("learning\\S091\\evidence\\bdd.json", 'utf8')); assert.equal(sha(fs.readFileSync("learning\\S091\\evidence\\raw\\runs\\canonical-source-red\\candidate-crash.feature.git.snapshot")), bdd.sha256, 'Current Git LF source must not be compared as raw bytes to historical working CRLF proof.');