:root {
  color-scheme: light;
  font-family: system-ui, sans-serif;
  color: #182b3a;
  background: #f1f5f8;
}
body { margin: 0 auto; max-width: 70rem; padding: 1rem; line-height: 1.5; }
header, section { background: #fff; padding: 1.25rem; margin-bottom: 1rem; border: 1px solid #a4b3bf; border-radius: .35rem; }
h1, h2, h3 { line-height: 1.25; }
.banner { padding: .85rem; background: #142c43; color: #fff; font-weight: 700; }
.warning { border-left: .3rem solid #855000; padding-left: 1rem; font-weight: 700; }
form { display: grid; gap: .75rem; max-width: 42rem; }
label { font-weight: 600; }
button, select { font: inherit; padding: .65rem; min-height: 2.8rem; }
button { color: #fff; background: #174a72; border: 2px solid #174a72; border-radius: .2rem; cursor: pointer; }
button:disabled { background: #edf0f3; color: #4b5965; border-color: #8997a2; cursor: not-allowed; }
select:disabled { color: #4b5965; }
:focus-visible { outline: 3px solid #8b4700; outline-offset: 3px; }
pre { background: #f2f5f8; border: 1px solid #a4b3bf; padding: 1rem; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .9rem; }
[role="alert"] { color: #861b14; border: 2px solid #861b14; padding: .75rem; font-weight: 600; }
#status-output { font-weight: 600; }
#lesson-reset { margin-top: .75rem; }
#history-output > li { padding: .7rem; border-bottom: 1px solid #a4b3bf; }
@media (max-width: 40rem) {
  body { padding: .5rem; }
  header, section { padding: .8rem; }
}
