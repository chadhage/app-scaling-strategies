:root {
  font-family: "Segoe UI", system-ui, sans-serif;
  color-scheme: light dark;
  background: #f5f7fb;
  color: #152238;
  line-height: 1.55;
}
* { box-sizing: border-box; }
body { margin: 0; }
main { max-width: 72rem; margin: auto; padding: 1.25rem; }
h1, h2, h3 { line-height: 1.25; }
section { background: #fff; border: 1px solid #a8b4c6; border-radius: .5rem; margin: 1rem 0; padding: 1rem; }
#training-banner { font-weight: 700; border: 3px solid #8b4e00; padding: .75rem; background: #fff2d9; }
.notice { border-left: .3rem solid #8b4e00; padding-left: 1rem; font-weight: 600; }
.choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }
label { display: block; font-weight: 600; margin-bottom: .35rem; }
select, button { font: inherit; padding: .6rem; border: 1px solid #65728a; border-radius: .3rem; }
select { width: 100%; background: #fff; color: #152238; }
button { background: #174e8a; color: #fff; cursor: pointer; }
button:disabled { background: #d5dce8; color: #475569; cursor: not-allowed; }
.actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1rem; }
:focus-visible { outline: 3px solid #b85c00; outline-offset: 3px; }
[aria-invalid="true"] { border: 3px solid #9d1818; }
#error { background: #fff0ef; color: #8b1414; border: 2px solid #9d1818; padding: .75rem; }
output { font-weight: 650; overflow-wrap: anywhere; }
.table-wrap { width: 100%; overflow-x: auto; margin: 1rem 0; }
table { width: 100%; min-width: 42rem; border-collapse: collapse; text-align: left; }
caption { text-align: left; font-weight: 600; margin-bottom: .5rem; }
th, td { border: 1px solid #a8b4c6; padding: .6rem; vertical-align: top; }
thead { background: #e7edf7; }
dt { font-weight: 600; }
dd { margin: .2rem 0 .8rem 1rem; overflow-wrap: anywhere; }
li { margin: .4rem 0; }
summary { cursor: pointer; font-weight: 600; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .85rem; max-height: 32rem; overflow: auto; }
footer { border-top: 1px solid #a8b4c6; }
@media (prefers-color-scheme: dark) {
  :root { background: #101927; color: #e4edfa; }
  section, select { background: #182438; color: #e4edfa; }
  thead { background: #243754; }
  #training-banner { background: #382b15; border-color: #eab465; }
  .notice { border-color: #eab465; }
  #error { background: #381c22; color: #ffd9d9; border-color: #fb9292; }
  [aria-invalid="true"] { border-color: #fb9292; }
  :focus-visible { outline-color: #ffcb75; }
}
