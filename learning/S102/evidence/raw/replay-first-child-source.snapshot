const fs=require('node:fs'),path=require('node:path'),Module=require('node:module'); const root="C:\\Users\\chhage\\repos\\app-scaling-strategies\\learning\\S102"; const modelPath=path.join(root,'model.js'); const m=new Module(modelPath); m.filename=modelPath; m.paths=Module._nodeModulePaths(root); m._compile(fs.readFileSync(path.join(root,'evidence','red','model.js.snapshot'),'utf8'),modelPath); require.cache[modelPath]=m; const p=path.join(root,'tests','model.test.cjs'); const t=new Module(p); t.filename=p; t.paths=Module._nodeModulePaths(path.dirname(p)); t._compile(fs.readFileSync(path.join(root,'evidence','red','model.test.cjs.snapshot'),'utf8'),p);