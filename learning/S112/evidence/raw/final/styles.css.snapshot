:root { color-scheme: light; font: 1rem/1.55 system-ui, sans-serif; color: #192638; background: #eef3f8; }
body { margin: 0; }
main { max-width: 76rem; margin: auto; padding: 1rem; }
header, section, footer { background: #fff; border: 1px solid #a6b4c4; border-radius: .35rem; padding: 1rem; margin: 0 0 1rem; }
h1, h2, h3 { line-height: 1.25; }
.banner { background: #ffebad; color: #302500; border: 2px solid #6d4b00; padding: .8rem; font-weight: 750; }
form, .actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; }
label { font-weight: 650; }
select, button, input { font: inherit; }
select { max-width: 100%; padding: .5rem; border: 1px solid #64758a; }
button { color: #fff; background: #174c85; border: 2px solid #174c85; border-radius: .25rem; padding: .6rem .8rem; min-height: 2.75rem; cursor: pointer; }
button:disabled { color: #334255; background: #e4e9ee; border-color: #a6b4c4; cursor: not-allowed; }
:focus-visible { outline: 3px solid #a74500; outline-offset: 3px; }
.confirmation { flex-basis: 100%; display: flex; align-items: flex-start; gap: .6rem; padding: .5rem 0; }
input[type="checkbox"] { width: 1.35rem; height: 1.35rem; flex-shrink: 0; }
.error { color: #861d17; background: #fff0ed; border: 2px solid #861d17; padding: .75rem; }
[hidden] { display: none !important; }
dl { display: grid; grid-template-columns: minmax(12rem, 1fr) 2fr; gap: .4rem 1rem; }
dt { font-weight: 700; }
dd { margin: 0; overflow-wrap: anywhere; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; }
caption { text-align: left; font-weight: 650; margin: .6rem 0; }
th, td { padding: .5rem; border: 1px solid #a6b4c4; vertical-align: top; overflow-wrap: anywhere; }
th { background: #e4edf7; }
#history > li { margin: 1rem 0; padding: .5rem; border-bottom: 2px solid #a6b4c4; }
footer { font-size: .95rem; }
@media (max-width: 42rem) {
  main { padding: .6rem; }
  dl { grid-template-columns: 1fr; }
  dd { margin-bottom: .7rem; }
  form { align-items: stretch; flex-direction: column; }
}
