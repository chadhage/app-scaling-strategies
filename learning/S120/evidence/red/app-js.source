(function () {
  'use strict';
  if (!window.S120) return;
  window.S120.create();
  document.querySelectorAll('button, input, select').forEach(function (control) { control.disabled = false; });
  document.querySelectorAll('form').forEach(function (form) {
    form.addEventListener('submit', function (event) { event.preventDefault(); });
  });
  document.getElementById('load-status').textContent = 'Fixed fictional fixture loaded; no live actions.';
}());
