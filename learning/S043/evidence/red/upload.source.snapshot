(function (root, factory) {
  'use strict';
  const api = factory();
  if (typeof module === 'object' && module.exports) module.exports = api;
  else root.MultipartLesson = api;
}(typeof globalThis === 'object' ? globalThis : this, function () {
  'use strict';
  function createSession() {
    const snapshot = {
      phase: 'idle',
      runCount: 0,
      commandCount: 0,
      current: { result: { outcome: 'unknown' } },
      history: [],
    };
    return {
      view: () => JSON.parse(JSON.stringify(snapshot)),
      dispatch: async () => ({ ok: true, view: JSON.parse(JSON.stringify(snapshot)) }),
    };
  }
  return { createSession };
}));
