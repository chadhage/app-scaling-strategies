'use strict';

(function publish(root) {
  function createLesson() {
    const snapshot = () => ({
      phase: 'idle',
      active: null,
      history: [],
      totals: { attempts: 0, submitted: 0, applied: 0, rejected: 0, unknown: 0, correct: 0 },
    });
    return Object.freeze({
      snapshot,
      start: snapshot,
      submitFirst: snapshot,
      submitContender: snapshot,
      checkPrediction: snapshot,
      newAttempt: snapshot,
      reset: snapshot,
    });
  }
  const api = Object.freeze({ createLesson });
  if (typeof module === 'object' && module.exports) module.exports = api;
  else root.PromotionLesson = api;
})(globalThis);
