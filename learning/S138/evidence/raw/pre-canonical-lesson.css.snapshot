:root { color-scheme: light; font-family: system-ui, sans-serif; color: #172c43; background: #f2f5f9; }
body { margin: 0; }
main { max-width: 64rem; margin: auto; padding: 1.5rem; }
h1 { line-height: 1.2; }
p, li { line-height: 1.55; }
section { background: white; border: 1px solid #a9bbcc; border-radius: .5rem; padding: 1rem; margin: 1rem 0; }
.banner { background: #fff3c0; border: 2px solid #755b00; padding: 1rem; font-weight: 700; }
.limits { border-left: .3rem solid #295b84; padding-left: .8rem; }
fieldset { border: 1px solid #9aafc2; display: flex; flex-direction: column; gap: .6rem; padding: 1rem; }
label, dt { font-weight: 650; }
button, input, select { font: inherit; padding: .65rem; max-width: 100%; }
button { background: #174c78; color: white; border: 2px solid #174c78; border-radius: .3rem; cursor: pointer; }
button:disabled { background: #e3e9ef; color: #45586c; border-color: #8697a7; cursor: not-allowed; }
:focus-visible { outline: 3px solid #9b3800; outline-offset: 3px; }
#reset-all { margin-top: 1rem; }
#error { background: #ffe6e3; color: #7a1c17; border: 2px solid #9b2c20; padding: 1rem; }
#verdict { font-weight: 750; }
.metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; }
.metrics div { border: 1px solid #cad5df; padding: .7rem; }
dd { margin: .35rem 0 0; overflow-wrap: anywhere; }
code, pre { overflow-wrap: anywhere; }
pre { white-space: pre-wrap; border: 1px solid #adbecd; padding: 1rem; font-size: .9rem; }
@media (max-width: 36rem) { main { padding: .6rem; } section { padding: .7rem; } }
