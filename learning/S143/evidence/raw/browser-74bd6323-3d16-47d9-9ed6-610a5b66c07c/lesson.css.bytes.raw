* { box-sizing: border-box; }
body { margin: 0; background: var(--cp-bg); color: var(--cp-text); font-family: "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif; line-height: 1.5; }
main { max-width: 1080px; margin: 0 auto; padding: 24px; }
h1, h2, h3 { line-height: 1.2; }
section { margin: 24px 0; padding: 20px; border: 1px solid var(--cp-border); border-radius: 16px; background: var(--cp-surface); }
.banner, .notice { padding: 12px 16px; border: 1px solid var(--cp-border-strong); border-radius: 0.625rem; background: var(--cp-accent-soft); }
.banner { font-weight: 700; }
label { display: block; font-weight: 600; margin: 12px 0 4px; }
select, button { font: inherit; border: 1px solid var(--cp-border-strong); border-radius: 0.625rem; padding: 8px 12px; background: var(--cp-surface); color: var(--cp-text); }
select { width: 100%; max-width: 640px; }
button { cursor: pointer; }
button:not(:disabled):hover { border-color: var(--cp-accent); background: var(--cp-accent-soft); }
button:disabled, select:disabled { color: var(--cp-text-muted); cursor: not-allowed; }
:focus-visible { outline: 3px solid var(--cp-accent); outline-offset: 3px; }
.buttons { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
#status { color: var(--cp-text-muted); }
#error { color: var(--cp-danger); font-weight: 600; min-height: 24px; }
.metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
.metrics div { padding: 12px; border: 1px solid var(--cp-border); border-radius: 0.625rem; background: var(--cp-surface-soft); }
dt { color: var(--cp-text-muted); }
dd { margin: 4px 0 0; font-weight: 600; }
.result { font-weight: 700; font-size: 1.25rem; padding: 12px; border-left: 4px solid var(--cp-border-strong); }
[data-result="PASS"] { color: var(--cp-success); }
[data-result="FAIL"] { color: var(--cp-danger); }
[data-result="UNKNOWN"] { color: var(--cp-text-muted); }
table { border-collapse: collapse; width: 100%; margin: 12px 0; }
caption { text-align: left; color: var(--cp-text-muted); padding: 8px 0; }
th, td { text-align: left; vertical-align: top; border-bottom: 1px solid var(--cp-border); padding: 8px; }
th { background: var(--cp-surface-soft); }
.table-scroll { overflow-x: auto; }
pre { overflow-wrap: anywhere; white-space: pre-wrap; font-family: Consolas, "Courier New", Courier, monospace; background: var(--cp-surface-soft); padding: 12px; border-radius: 0.625rem; }
details { margin: 12px 0; }
summary { cursor: pointer; }
li { margin: 8px 0; overflow-wrap: anywhere; }
footer { font-size: 0.875rem; color: var(--cp-text-muted); margin: 24px 0; }
@media (max-width: 600px) { main { padding: 12px; } section { padding: 12px; } .buttons button { width: 100%; } }
