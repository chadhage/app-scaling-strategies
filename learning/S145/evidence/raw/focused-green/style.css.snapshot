:root {
  color-scheme: light;
  --cp-bg: #f7f4ef;
  --cp-bg-elevated: #fcfbf8;
  --cp-surface: #ffffff;
  --cp-surface-soft: #f5f5f5;
  --cp-border: #dedede;
  --cp-border-strong: #919191;
  --cp-text: #242424;
  --cp-text-muted: #5c5c5c;
  --cp-text-soft: #6f6f6f;
  --cp-accent: #b11f4b;
  --cp-accent-hover: #9a1a41;
  --cp-accent-soft: rgba(177, 31, 75, 0.08);
  --cp-accent-fg: #ffffff;
  --cp-success: #16a34a;
  --cp-danger: #dc2626;
  --cp-warning: #f59e0b;
  --cp-link: #0078d4;
  --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
  --cp-overlay: rgba(255, 255, 255, 0.8);
  --cp-panel: rgba(255, 255, 255, 0.86);
  --cp-panel-strong: rgba(255, 255, 255, 0.96);
  --cp-sheen: rgba(255, 255, 255, 0.55);
  --cp-highlight: rgba(177, 31, 75, 0.12);
}
html[data-theme="dark"] {
  color-scheme: dark;
  --cp-bg: #3d3b3a;
  --cp-bg-elevated: #343231;
  --cp-surface: #292929;
  --cp-surface-soft: #2e2e2e;
  --cp-border: #474747;
  --cp-border-strong: #5f5f5f;
  --cp-text: #dedede;
  --cp-text-muted: #919191;
  --cp-text-soft: #b0b0b0;
  --cp-accent: #fd8ea1;
  --cp-accent-hover: #fb7b91;
  --cp-accent-soft: rgba(253, 142, 161, 0.14);
  --cp-accent-fg: #1a1a1a;
  --cp-success: #4ade80;
  --cp-danger: #f87171;
  --cp-warning: #fbbf24;
  --cp-link: #4da6ff;
  --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
  --cp-overlay: rgba(41, 41, 41, 0.88);
  --cp-panel: rgba(41, 41, 41, 0.72);
  --cp-panel-strong: rgba(41, 41, 41, 0.96);
  --cp-sheen: rgba(255, 255, 255, 0.04);
  --cp-highlight: rgba(253, 142, 161, 0.12);
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--cp-bg); color: var(--cp-text); font: 1rem/1.5 "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif; }
header, main, footer { max-width: 76rem; margin: auto; padding: 1rem; }
h1 { font-size: clamp(1.5rem, 4vw, 2.25rem); line-height: 1.25; }
h2 { font-size: 1.4rem; }
section { margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--cp-border); border-radius: 16px; background: var(--cp-surface); box-shadow: 0 1px 2px var(--cp-border); }
.banner { padding: 0.75rem; border: 2px solid var(--cp-accent); border-radius: 0.625rem; font-weight: 700; background: var(--cp-accent-soft); }
.limit, caption, #trace-help { color: var(--cp-text-muted); }
label { display: block; font-weight: 600; margin-bottom: 0.5rem; }
button, select { padding: 0.75rem; border: 1px solid var(--cp-border-strong); border-radius: 0.625rem; background: var(--cp-surface); color: var(--cp-text); font: inherit; min-height: 2.75rem; max-width: 100%; }
select { display: block; width: 100%; }
button { cursor: pointer; }
button:hover:not(:disabled) { background: var(--cp-accent-soft); border-color: var(--cp-accent-hover); }
button:disabled { color: var(--cp-text-muted); cursor: not-allowed; background: var(--cp-surface-soft); }
#begin-run { background: var(--cp-accent); color: var(--cp-accent-fg); }
#begin-run:disabled { background: var(--cp-surface-soft); color: var(--cp-text-muted); }
.actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
:focus-visible { outline: 3px solid var(--cp-accent); outline-offset: 3px; }
.error { padding: 0.75rem; border: 2px solid var(--cp-danger); border-radius: 0.625rem; color: var(--cp-text); font-weight: 600; }
.error:empty { display: none; }
.verdict { font-weight: 700; border-left: 4px solid var(--cp-accent); padding-left: 0.75rem; }
.table-scroll { overflow-x: auto; max-width: 100%; }
table { border-collapse: collapse; width: 100%; }
caption { padding: 0.5rem; text-align: left; }
th, td { border: 1px solid var(--cp-border); padding: 0.75rem; text-align: left; vertical-align: top; }
th { background: var(--cp-surface-soft); }
[data-status="FAIL"] { font-weight: 700; border-left: 4px solid var(--cp-danger); }
[data-status="UNKNOWN"] { font-weight: 700; border-left: 4px solid var(--cp-warning); }
pre, code { font-family: Consolas, "Courier New", Courier, monospace; }
pre { overflow: auto; max-height: 28rem; white-space: pre-wrap; overflow-wrap: anywhere; padding: 0.75rem; border: 1px solid var(--cp-border); background: var(--cp-surface-soft); }
details { margin: 0.75rem 0; }
summary { cursor: pointer; padding: 0.5rem; }
li { margin-bottom: 0.5rem; }
a { color: var(--cp-link); }
.skip { position: absolute; top: -5rem; left: 1rem; padding: 0.5rem; background: var(--cp-surface); }
.skip:focus { top: 0.5rem; }
@media (max-width: 36rem) {
  header, main, footer, section { padding: 0.75rem; }
  .actions button { width: 100%; }
  th, td { padding: 0.5rem; }
}
