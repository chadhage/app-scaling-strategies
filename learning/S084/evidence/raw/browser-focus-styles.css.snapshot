:root { color-scheme: light; font-family: system-ui, sans-serif; color: #162c40; background: #f2f5fa; }
* { box-sizing: border-box; }
body { margin: 0 auto; max-width: 76rem; padding: 1rem; line-height: 1.55; }
header, section { background: white; border: 1px solid #aebdcd; border-radius: .45rem; padding: 1.1rem; margin-bottom: 1rem; min-width: 0; }
h1 { font-size: clamp(1.5rem, 4vw, 2.2rem); line-height: 1.25; }
h2 { font-size: 1.3rem; }
h3 { font-size: 1.05rem; }
.banner { background: #162c40; color: white; padding: .8rem; font-weight: 750; border-radius: .25rem; }
a { color: #074e96; }
.skip { position: absolute; top: -8rem; left: 1rem; background: white; padding: .7rem; z-index: 1; }
.skip:focus { top: .5rem; }
:focus-visible { outline: 3px solid #8a3200; outline-offset: 3px; }
fieldset { border: 1px solid #788fa4; margin: .5rem 0 1rem; padding: 1rem; min-width: 0; }
legend { font-weight: 700; }
label { display: block; font-weight: 650; margin-top: .5rem; }
select, button { font: inherit; max-width: 100%; padding: .55rem .65rem; min-height: 2.75rem; border: 1px solid #4e657d; border-radius: .2rem; }
select { display: block; width: 100%; background: white; color: #162c40; margin: .25rem 0 .7rem; }
button { cursor: pointer; background: #174e81; color: white; }
button:disabled { cursor: not-allowed; background: #e1e6ed; color: #4a5766; }
.actions { display: flex; flex-wrap: wrap; gap: .65rem; margin: .75rem 0; }
[aria-invalid="true"] { border: 3px solid #a02323; }
#input-error { color: #7c1010; background: #fff1ef; border: 2px solid #a02323; padding: .8rem; }
output { display: block; font-size: 1.2rem; font-weight: 750; }
[data-verdict="PASS"] { color: #14602c; }
[data-verdict="FAIL"] { color: #931717; }
[data-verdict="UNKNOWN"] { color: #744500; }
.table-region { max-width: 100%; overflow-x: auto; margin: .8rem 0; border: 1px solid #aebdcd; }
table { border-collapse: collapse; width: 100%; min-width: 54rem; }
caption { text-align: left; font-weight: 650; padding: .6rem; }
th, td { padding: .6rem; text-align: left; vertical-align: top; border: 1px solid #c2cdda; overflow-wrap: anywhere; }
th { background: #e9f0f8; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #f1f5fa; padding: .8rem; font-size: .9rem; }
details { border: 1px solid #aebdcd; padding: .7rem; margin-top: .8rem; }
summary { cursor: pointer; font-weight: 650; }
[hidden] { display: none !important; }
@media (max-width: 32rem) {
  body { padding: .55rem; }
  header, section { padding: .8rem; }
  .actions { display: grid; }
  .actions button { width: 100%; }
}
