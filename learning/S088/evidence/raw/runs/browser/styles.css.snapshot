:root { color-scheme: light; font-family: system-ui, sans-serif; color: #17283e; background: #f2f5fa; line-height: 1.55; }
* { box-sizing: border-box; }
body { margin: 0; }
main { max-width: 72rem; margin: auto; padding: 1rem; }
h1, h2, h3 { line-height: 1.25; }
section { background: white; margin: 1.2rem 0; padding: 1.2rem; border: 1px solid #aebed0; border-radius: .4rem; }
.banner { padding: .8rem; background: #173c60; color: white; font-weight: 700; border: 2px solid #173c60; }
a { color: #064da5; }
.skip { position: absolute; left: 1rem; top: -5rem; background: white; padding: .5rem; }
.skip:focus { top: .4rem; }
label { display: block; font-weight: 650; margin-top: .8rem; }
select, button { font: inherit; padding: .65rem; min-height: 2.8rem; max-width: 100%; }
select { display: block; width: 35rem; background: white; color: #17283e; border: 1px solid #526b87; }
button { cursor: pointer; border: 2px solid #164c82; background: #164c82; color: white; border-radius: .25rem; }
button[type="button"] { background: white; color: #164c82; }
button:disabled, select:disabled { cursor: not-allowed; background: #e2e8ef; color: #475569; }
.buttons { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
:focus-visible { outline: 3px solid #b24700; outline-offset: 3px; }
.state-grid { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
.state-grid div { min-width: 7rem; }
dt { font-weight: 650; }
dd { margin: 0; font-variant-numeric: tabular-nums; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #edf2f8; padding: 1rem; border: 1px solid #aebed0; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: .95rem; }
caption { text-align: left; font-weight: 650; margin-bottom: .5rem; }
th, td { padding: .55rem; border: 1px solid #aebed0; text-align: left; vertical-align: top; }
th { background: #edf2f8; }
[data-outcome="failure"], [data-verdict="fail"], #input-error { color: #8d1717; }
[data-outcome="success"], [data-verdict="pass"] { color: #165c37; }
[data-outcome="unknown"], [data-verdict="unknown"] { color: #744400; }
[hidden] { display: none !important; }
@media (max-width: 40rem) { main { padding: .65rem; } section { padding: .8rem; } }
