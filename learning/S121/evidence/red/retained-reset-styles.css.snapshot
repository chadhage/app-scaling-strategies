:root { color-scheme: light; font: 1rem/1.55 system-ui, sans-serif; color: #182b3a; background: #f5f7fa; }
body { margin: 0; }
main { max-width: 72rem; margin: auto; padding: 1.2rem; }
h1, h2, h3 { line-height: 1.25; }
section { margin: 1.5rem 0; padding: 1rem; background: white; border: 1px solid #8b9bab; border-radius: .4rem; }
.banner { padding: 1rem; font-weight: 750; color: #2e2500; background: #ffed9e; border: 2px solid #795900; }
label { display: block; font-weight: 650; margin: .75rem 0 .25rem; }
select, button { font: inherit; padding: .55rem .7rem; max-width: 100%; border: 1px solid #516a80; border-radius: .25rem; }
select { width: 100%; }
button { margin: .4rem .25rem .4rem 0; color: white; background: #15466b; cursor: pointer; min-height: 2.75rem; }
button:disabled { cursor: default; color: #334554; background: #e2e8ee; }
input[type="checkbox"] { width: 1.2rem; height: 1.2rem; vertical-align: middle; }
.acknowledgement { padding: .5rem 0; }
:focus-visible, [tabindex="-1"]:focus { outline: 3px solid #a54500; outline-offset: 3px; }
[aria-invalid="true"] { border: 3px solid #a11724; }
#input-error { padding: .8rem; border: 2px solid #a11724; background: #fff0f1; color: #77101a; font-weight: 650; }
[hidden] { display: none; }
dl { display: grid; grid-template-columns: minmax(12rem, 1fr) 2fr; gap: .5rem 1rem; }
dt { font-weight: 700; }
dd { margin: 0; overflow-wrap: anywhere; }
.table-scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; margin: 1.2rem 0; }
caption { text-align: left; font-weight: 700; margin-bottom: .4rem; }
td, th { text-align: left; vertical-align: top; border: 1px solid #8b9bab; padding: .55rem; }
th { background: #e6edf4; }
li { margin: .35rem 0; overflow-wrap: anywhere; }
@media (max-width: 42rem) {
  main { padding: .75rem; }
  section { padding: .75rem; }
  dl { grid-template-columns: 1fr; }
  dd { margin-bottom: .5rem; }
  .actions button { width: 100%; }
}
