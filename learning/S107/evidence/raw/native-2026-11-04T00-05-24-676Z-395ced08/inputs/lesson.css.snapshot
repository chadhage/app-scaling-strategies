:root { color-scheme: light; font: 17px/1.55 system-ui, sans-serif; color: #172638; background: #f5f7fa; }
body { max-width: 68rem; margin: auto; padding: 1.5rem; }
.banner { background: #fff0b8; border: 2px solid #7b5900; padding: .8rem; font-weight: 700; }
section { background: white; margin: 1rem 0; padding: 1rem; border: 1px solid #a5b5c8; }
form { display: grid; gap: .8rem; }
label { display: grid; gap: .2rem; font-weight: 600; }
select, button { font: inherit; padding: .5rem; }
button { text-align: left; cursor: pointer; border: 2px solid #214f7b; background: #eef5ff; }
button:disabled { cursor: default; opacity: .65; }
:focus-visible { outline: 3px solid #9a3500; outline-offset: 3px; }
.skip { position: absolute; transform: translateY(-300%); background: white; padding: .5rem; }
.skip:focus { position: static; transform: none; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #edf1f5; padding: .7rem; }
#error { color: #8b1420; border: 2px solid #8b1420; padding: .6rem; }
#history li { margin-bottom: .6rem; padding: .4rem; border-left: 4px solid #567086; }
#history li[data-impact="interrupted"] { border-color: #a52030; }
#history li[data-impact="preserved"] { border-color: #237346; }
code { overflow-wrap: anywhere; }
